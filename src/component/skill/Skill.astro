import { data } from "../../Data";
import SectionTitle from "../SectionTitle.astro";
---

<section id="skills" class="skills">
  <div class="container">
    <SectionTitle id="skills">Skills</SectionTitle>
    <div class="grid">
      {data.skills.map((skill) => (
        <div class="grid-item">
          <div class="content">
            <h3>
              {skill.emoji} {skill.name}
            </h3>
            <p>{skill.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
